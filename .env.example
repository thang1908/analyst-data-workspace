# Database Configuration
DATABASE_URL=postgresql+psycopg://cx_user:cx_password@localhost:5432/cx_intelligence
ASYNC_DATABASE_URL=postgresql+psycopg://cx_user:cx_password@localhost:5432/cx_intelligence

# Application Settings
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Object Storage (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cx-feedback-imports
S3_REGION=us-east-1

# SSO Configuration
SSO_ISSUER=https://auth.example.com
SSO_CLIENT_ID=cx-platform
SSO_CLIENT_SECRET=sso-client-secret

# AI Model Endpoint
AI_INFERENCE_ENDPOINT=http://localhost:8000/predict
AI_API_KEY=ai-api-key-placeholder
